;-------------------------------------------------------------------------------
Macro: MnAutoStart
;--- Place ELECTRONIC ASSEMBLY logo ---
	#TA				; Terminal off
	#UI 0,0,6			; place logo

;--- Place Picture ---
	#UI 0,120, 7		; place picture no. 6 at pixelpostion 10|20

	


	
	
	

	
