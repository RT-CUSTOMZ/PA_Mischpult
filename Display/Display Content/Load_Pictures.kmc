eDIP320-8   "BMP-File"     ; define eDIP, "Projectname" max. 32 character

AutoScan: 1 			; autoscan for correct baud rate to connect to eDIP on COM/USB

COM8: 115200					; program eDIP on COMx with 115200 Baud
;USB: 115200, "eDIP Programmer"	; use EA 9777-USB eDIP Programmer and program eDIP with 115200 baud

;VERIFY					; verify after program

;------------------------------------------------------------------------------
; load defaults

include <..\ELECTRONIC_ASSEMBLY_LCD-Tools-Portable_V45\Data\eDIP - intelligent graphic displays\eDIP320-8\default_constant.kmi>	; double click to open
include <..\ELECTRONIC_ASSEMBLY_LCD-Tools-Portable_V45\Data\eDIP - intelligent graphic displays\eDIP320-8\default_font.kmi>
include <..\ELECTRONIC_ASSEMBLY_LCD-Tools-Portable_V45\Data\eDIP - intelligent graphic displays\eDIP320-8\default_pictures.kmi>


;-------------------------------------------------------------------------------

MnAutoStart = 0

PowerOnMacro:		; runs after power-on
	#MN MnAutoStart

ResetMacro:		; runs after external reset
	#MN MnAutoStart

WatchdogMacro:	; runs after a crash (>1000ms)
	#MN MnAutoStart

BrownOutMacro:	; runs when supply voltage drops <3V
	#MN MnAutoStart


;-------------------------------------------------------------------------------
Path <..\Display Content\Bitmaps>	; define standard path
Picture: 6 <RTCustomz.bmp>	; define picture no. 6
Picture: 7 <WH.bmp>		; define poicture no. 7
Picture: 8 <SPDIF_Audio.bmp>,<SPDIF_Audio_Selected.bmp>
Picture: 9 <USB_Audio.bmp>,<USB_Audio_Selected.bmp>
